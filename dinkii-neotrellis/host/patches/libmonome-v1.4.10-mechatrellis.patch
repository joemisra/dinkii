+
+static int mext_mechatrellis_rgb_set(monome_t *monome, uint_t x, uint_t y,
+                                     uint_t red, uint_t green, uint_t blue) {
+	mext_msg_t msg = {
+		.addr = SS_MECHATRELLIS,
+		.cmd = CMD_MECHATRELLIS_RGB_SET
+	};
+
+	ROTATE_COORDS(monome, x, y);
+	msg.payload.mechatrellis_rgb_set.led.x = x;
+	msg.payload.mechatrellis_rgb_set.led.y = y;
+	msg.payload.mechatrellis_rgb_set.red = red;
+	msg.payload.mechatrellis_rgb_set.green = green;
+	msg.payload.mechatrellis_rgb_set.blue = blue;
+	return mext_write_msg(monome, &msg);
+}
+
+static int mext_mechatrellis_rgb_all(monome_t *monome, uint_t red,
+                                     uint_t green, uint_t blue) {
+	mext_msg_t msg = {
+		.addr = SS_MECHATRELLIS,
+		.cmd = CMD_MECHATRELLIS_RGB_ALL,
+		.payload = {
+			.mechatrellis_rgb_all = {
+				.red = red,
+				.green = green,
+				.blue = blue
+			}
+		}
+	};
+	return mext_write_msg(monome, &msg);
+}
